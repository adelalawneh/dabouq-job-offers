# Portal SSO
PORTAL_URL=https://www.dabouqtools.com
NEXT_PUBLIC_PORTAL_URL=https://www.dabouqtools.com
PORTAL_ONLY=true
# App identity in the portal catalog, and its SSO client secret.
# Generate the secret in the portal: Admin → Applications → Generate secret.
# Shown once. Server-side only — never prefix it with NEXT_PUBLIC_.
DABOUQ_APP_SLUG=job-offers
DABOUQ_CLIENT_SECRET=

# Signs this app's own session cookie. Required in production, min 32 chars.
# openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string

# Public URL of this app (candidate links)
APP_BASE_URL=https://offers.dabouqtools.com

# Database (same Supabase Postgres as portal)
DATABASE_URL=postgresql://...
DIRECT_URL=postgresql://...

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
HR_EMAIL=

# Optional OCR
GEMINI_API_KEY=
